const COL_KEYS = ['note','section','place','spec'];
const PALETTE = ['#2563eb','#f59e0b','#059669','#7c3aed','#db2777','#0891b2','#ea580c','#4f46e5','#65a30d','#e11d48'];

const esc = s => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
const valOf = (r,k) => (r[k] && String(r[k]).trim()) || '—';

function prettify(s){
  if(s == null) return '';
  let out = String(s);
  out = out.replace(/[٠-٩]/g, d => String('٠١٢٣٤٥٦٧٨٩'.indexOf(d)));
  out = out.replace(/[۰-۹]/g, d => String('۰۱۲۳۴۵۶۷۸۹'.indexOf(d)));
  out = out.replace(/[\u200B-\u200F\u202A-\u202E\uFEFF]/g, '');
  out = out.replace(/ـ/g, '');
  out = out.trim().replace(/\s+/g, ' ');
  out = out.replace(/([ء-ي])(\d)/g, '$1 $2');
  out = out.replace(/(\d)([ء-ي])/g, '$1 $2');
  out = out.trim().replace(/\s+/g, ' ');
  return out;
}
function normalizeKey(s){
  if(s == null) return '';
  let out = String(s);
  out = out.replace(/[٠-٩]/g, d => String('٠١٢٣٤٥٦٧٨٩'.indexOf(d)));
  out = out.replace(/[۰-۹]/g, d => String('۰۱۲۳۴۵۶۷۸۹'.indexOf(d)));
  out = out.replace(/[\u200B-\u200F\u202A-\u202E\uFEFF]/g, '');
  out = out.replace(/ـ/g, '');
  out = out.replace(/[أإآ]/g, 'ا');
  out = out.replace(/ى/g, 'ي');
  out = out.replace(/ة/g, 'ه');
  out = out.replace(/ء$/, '');
  out = out.trim().replace(/\s+/g, ' ');
  out = out.replace(/([ء-ي])(\d)/g, '$1 $2');
  out = out.replace(/(\d)([ء-ي])/g, '$1 $2');
  out = out.trim().replace(/\s+/g, ' ');
  return out;
}
function fitFont(text, base, min, maxLen){
  const len = String(text).length;
  if(len <= maxLen) return base;
  return Math.max(min, base - Math.ceil((len - maxLen) * 0.7));
}

