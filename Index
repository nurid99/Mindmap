   ============================================================ */
let records;
let nextId;

/* التحديد: مفاتيح A أو أزواج B */
let selectedAKeys = new Set();
let selectedBPairs = new Set();

function hasSelection(){
  return selectedAKeys.size > 0 || selectedBPairs.size > 0;
}

function toggleASelection(aKey){
  if(selectedAKeys.has(aKey)){
    selectedAKeys.delete(aKey);
  } else {
    selectedAKeys.add(aKey);
    for(const p of [...selectedBPairs]){
      if(p.startsWith(aKey + '::')) selectedBPairs.delete(p);
    }
  }
}

function toggleBSelection(aKey, bKey){
  const pair = `${aKey}::${bKey}`;
  if(selectedBPairs.has(pair)){
    selectedBPairs.delete(pair);
  } else {
    selectedBPairs.add(pair);
    selectedAKeys.delete(aKey);
  }
}

function clearSelection(){
  selectedAKeys.clear();
  selectedBPairs.clear();
}

/* السجلات المطابقة للتحديد (أو null إذا لم يوجد تحديد) */
function getSelectedRecords(){
  if(!hasSelection()) return null;
  const A = colA.value, B = colB.value;
  return records.filter(r => {
    const aKey = normalizeKey(valOf(r, A)) || '—';
    const bKey = normalizeKey(valOf(r, B)) || '—';
    return selectedAKeys.has(aKey) || selectedBPairs.has(`${aKey}::${bKey}`);
  });
}

/* المصدر النهائي للتصدير/الطباعة (تحديد + فلتر أرشيف) */
function getSourceForExport(){
  const sel = getSelectedRecords();
  const base = sel !== null ? sel : records;
  return showArchived.checked ? base : base.filter(r => !r.archived);
}

/* إزالة تحديدات لم تعد موجودة (بعد حذف/أرشفة) */
function pruneSelection(){
  if(!hasSelection()) return;
  const A = colA.value, B = colB.value;
  const showArch = showArchived.checked;
  const source = showArch ? records : records.filter(r => !r.archived);

  const validA = new Set(), validB = new Set();
  source.forEach(r => {
    const aKey = normalizeKey(valOf(r, A)) || '—';
    const bKey = normalizeKey(valOf(r, B)) || '—';
    validA.add(aKey);
    validB.add(`${aKey}::${bKey}`);
  });

  for(const k of [...selectedAKeys]) if(!validA.has(k)) selectedAKeys.delete(k);
  for(const p of [...selectedBPairs]) if(!validB.has(p)) selectedBPairs.delete(p);
}

/* تحديث واجهة التحديد */
function updateSelectionUI(){
  const branches = selectedAKeys.size + selectedBPairs.size;
  const recs = getSelectedRecords()?.length || 0;
  const info = document.getElementById('selInfo');
  const sep = document.getElementById('selSep');
  if(branches > 0){
    info.classList.add('on');
    sep.style.display = 'block';
    document.getElementById('selBranches').textContent = branches;
    document.getElementById('selRecords').textContent = recs;
  } else {
    info.classList.remove('on');
    sep.style.display = 'none';
  }
}

