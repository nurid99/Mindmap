/* ============================================================
   6) تجميع
   ============================================================ */
function groupRecords(source, A, B){
  const groups = {}, aForms = {}, bForms = {}, aDisplay = {}, bDisplay = {};
  source.forEach(r => {
    const aRaw = valOf(r, A), bRaw = valOf(r, B);
    const aKey = normalizeKey(aRaw) || '—';
    const bKey = normalizeKey(bRaw) || '—';
    if(!aForms[aKey]) aForms[aKey] = new Set();
    aForms[aKey].add(aRaw);
    if(!aDisplay[aKey]) aDisplay[aKey] = prettify(aRaw) || '—';
    if(!bForms[bKey]) bForms[bKey] = new Set();
    bForms[bKey].add(bRaw);
    if(!bDisplay[bKey]) bDisplay[bKey] = prettify(bRaw) || '—';
    if(!groups[aKey]) groups[aKey] = {};
    if(!groups[aKey][bKey]) groups[aKey][bKey] = [];
    groups[aKey][bKey].push(r);
  });
  return { groups, aForms, bForms, aDisplay, bDisplay };
}

/* ============================================================
   7) بناء SVG — دالة نقية تأخذ source
   ============================================================ */
function buildMapSVGString(source, A, B){
  const { groups, aForms, bForms, aDisplay, bDisplay } = groupRecords(source, A, B);
  const aKeys = Object.keys(groups);
  if(aKeys.length === 0) return '';

  const W = 900;
  const rootW = 170, rootH = 70;
  const aW = 150, aH = 48;
  const bW = 140, bH = 38;
  const leafW = 240, leafH = 44;
  const gapX = 52;
  const ROW_H = 48, PAD_B = 12, PAD_A = 18, TOP = 40, BOTTOM = 40;

  const rootX = W - 20 - rootW;
  const aX = rootX - gapX - aW;
  const bX = aX - gapX - bW;
  const leafX = bX - gapX - leafW;

  let y = TOP;
  const aNodes = [], bNodes = [], leaves = [];

  aKeys.forEach((aKey, ai) => {
    const aStart = y;
    const color = PALETTE[ai % PALETTE.length];
    const bKeys = Object.keys(groups[aKey]);
    bKeys.forEach(bKey => {
      const bStart = y;
      const bNode = { key:bKey, y:0, color, _a:aKey, _b:bKey };
      groups[aKey][bKey].forEach(rec => {
        leaves.push({ rec, y: y + ROW_H/2, color, _a:aKey, _b:bKey });
        y += ROW_H;
      });
      y += PAD_B;
      bNode.y = (bStart + y - PAD_B) / 2;
      bNodes.push(bNode);
    });
    y += PAD_A;
    aNodes.push({ key:aKey, y: (aStart + y - PAD_A) / 2, color });
  });

  const totalH = Math.max(y + BOTTOM, 340);
  const rootCY = totalH / 2;
  const rootLeft = rootX;

  const svg = [];
  svg.push(`<svg viewBox="0 0 ${W} ${totalH}" width="${W}" height="${totalH}" xmlns="http://www.w3.org/2000/svg">`);

  aNodes.forEach(a => {
    svg.push(`<path d="M${rootLeft} ${rootCY} C ${rootLeft-65} ${rootCY}, ${aX+aW+65} ${a.y}, ${aX+aW} ${a.y}"
      fill="none" stroke="${a.color}" stroke-width="2.6" stroke-opacity="0.45" stroke-linecap="round"/>`);
    svg.push(`<circle cx="${aX+aW}" cy="${a.y}" r="4.5" fill="${a.color}" opacity="0.85"/>`);
  });
  bNodes.forEach(b => {
    const a = aNodes.find(x => x.key === b._a);
    if(!a) return;
    svg.push(`<path d="M${aX} ${a.y} C ${aX-50} ${a.y}, ${bX+bW+50} ${b.y}, ${bX+bW} ${b.y}"
      fill="none" stroke="${b.color}" stroke-width="2" stroke-opacity="0.4" stroke-linecap="round"/>`);
    svg.push(`<circle cx="${bX+bW}" cy="${b.y}" r="3.5" fill="${b.color}" opacity="0.75"/>`);
  });
  leaves.forEach(lf => {
    const b = bNodes.find(x => x._a === lf._a && x._b === lf._b);
    if(!b) return;
    svg.push(`<path d="M${bX} ${b.y} C ${bX-45} ${b.y}, ${leafX+leafW+45} ${lf.y}, ${leafX+leafW} ${lf.y}"
      fill="none" stroke="${lf.color}" stroke-width="1.6" stroke-opacity="0.3" stroke-linecap="round"/>`);
  });

  /* A nodes */
  aNodes.forEach(a => {
    const displayVal = aDisplay[a.key] || a.key;
    const variants = Array.from(aForms[a.key] || []);
    const title = variants.length > 1 ? variants.join(' / ') : displayVal;
    const isSel = selectedAKeys.has(a.key);
    const tip = isSel ? `${title} — محدد (انقر للإلغاء)` : `${title} — انقر لتحديد هذا الفرع`;
    const fs = fitFont(displayVal, 16, 10, 13);
    const colLabel = columnNames[A] || DEFAULT_COL_NAMES[A];

    svg.push(`<g class="node-a" data-a-key="${esc(a.key)}">`);
    svg.push(`<title>${esc(tip)}</title>`);

    /* halo if selected */
    if(isSel){
      svg.push(`<rect x="${aX-4}" y="${a.y-aH/2-4}" width="${aW+8}" height="${aH+8}" rx="18"
        fill="none" stroke="#10b981" stroke-width="2.5" pointer-events="none"/>`);
    }

    svg.push(`<rect x="${aX}" y="${a.y-aH/2}" width="${aW}" height="${aH}" rx="14" fill="${a.color}"/>`);
    svg.push(`<text x="${aX+aW/2+6}" y="${a.y-8}" text-anchor="middle" dominant-baseline="middle"
      font-size="10.5" font-weight="600" fill="#ffffff" opacity="0.8">${esc(colLabel)}</text>`);
    svg.push(`<text x="${aX+aW/2+6}" y="${a.y+10}" text-anchor="middle" dominant-baseline="middle"
      font-size="${fs}" font-weight="800" fill="#ffffff">${esc(displayVal)}</text>`);

    /* selection badge (top-right of the rect, visual) */
    if(isSel){
      svg.push(`<circle cx="${aX+aW-12}" cy="${a.y-aH/2+12}" r="9" fill="#10b981" stroke="#ffffff" stroke-width="2" pointer-events="none"/>`);
      svg.push(`<path d="M${aX+aW-16} ${a.y-aH/2+12} l2.8 2.8 l5 -5" stroke="#ffffff" stroke-width="2.2"
        fill="none" stroke-linecap="round" stroke-linejoin="round" pointer-events="none"/>`);
    }

    /* delete × */
    svg.push(`<g class="delx" data-type="a" data-key="${esc(a.key)}">
      <circle cx="${aX+14}" cy="${a.y}" r="9" fill="#ffffff" stroke="${a.color}" stroke-width="1.6"/>
      <text x="${aX+14}" y="${a.y}" text-anchor="middle" dominant-baseline="central"
            font-size="13" font-weight="800" fill="${a.color}">×</text>
    </g></g>`);
  });

  /* B nodes */
  bNodes.forEach(b => {
    const displayVal = bDisplay[b.key] || b.key;
    const variants = Array.from(bForms[b.key] || []);
    const title = variants.length > 1 ? variants.join(' / ') : displayVal;
    const pair = `${b._a}::${b.key}`;
    const isSel = selectedBPairs.has(pair);
    const tip = isSel ? `${title} — محدد (انقر للإلغاء)` : `${title} — انقر لتحديد هذا الفرع`;
    const fs = fitFont(displayVal, 14, 9, 12);

    svg.push(`<g class="node-b" data-a-key="${esc(b._a)}" data-b-key="${esc(b.key)}">`);
    svg.push(`<title>${esc(tip)}</title>`);

    if(isSel){
      svg.push(`<rect x="${bX-4}" y="${b.y-bH/2-4}" width="${bW+8}" height="${bH+8}" rx="16"
        fill="none" stroke="#10b981" stroke-width="2.2" pointer-events="none"/>`);
    }

    svg.push(`<rect x="${bX}" y="${b.y-bH/2}" width="${bW}" height="${bH}" rx="12"
      fill="#ffffff" stroke="${b.color}" stroke-width="1.8" stroke-opacity="0.75"/>`);
    svg.push(`<text x="${bX+bW/2+5}" y="${b.y}" text-anchor="middle" dominant-baseline="middle"
      font-size="${fs}" font-weight="700" fill="${b.color}">${esc(displayVal)}</text>`);

    if(isSel){
      svg.push(`<circle cx="${bX+bW-10}" cy="${b.y-bH/2+10}" r="8" fill="#10b981" stroke="#ffffff" stroke-width="1.8" pointer-events="none"/>`);
      svg.push(`<path d="M${bX+bW-13.5} ${b.y-bH/2+10} l2.2 2.2 l4 -4" stroke="#ffffff" stroke-width="2"
        fill="none" stroke-linecap="round" stroke-linejoin="round" pointer-events="none"/>`);
    }

    svg.push(`<g class="delx" data-type="b" data-a="${esc(b._a)}" data-b="${esc(b.key)}">
      <circle cx="${bX+13}" cy="${b.y}" r="8" fill="#ffffff" stroke="${b.color}" stroke-width="1.4"/>
      <text x="${bX+13}" y="${b.y}" text-anchor="middle" dominant-baseline="central"
            font-size="12" font-weight="800" fill="${b.color}">×</text>
    </g></g>`);
  });

  /* Leaves */
  const subKeys = COL_KEYS.filter(k => k !== A && k !== B && k !== 'note');
